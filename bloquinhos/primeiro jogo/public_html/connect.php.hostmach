if(!($id = mysql_connect("{DB_HOST}", "{DB_USER}", "{DB_PASSWORD}"))) {
   echo "Não foi possível estabelecer uma conexão com o gerenciador MySQL. Favor Contactar o Administrador.";
   exit;
}
if(!($con=mysql_select_db("{DB_NAME}",$id))) {
   echo "Não foi possível estabelecer uma conexão com o gerenciador MySQL. Favor Contactar o Administrador.";
   exit;
}
?>