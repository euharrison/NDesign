{
  "name": "bloquinhos-html5",
  "version": "1.0.0",
  "private": true,
  "description": "HTML5/TypeScript port of the NDesign Bloquinhos block-demolition game (originally Flash/AS3 + Box2D)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "levels": "node scripts/convert-levels.mjs",
    "fla": "node scripts/read-fla.mjs"
  },
  "dependencies": {
    "planck": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
